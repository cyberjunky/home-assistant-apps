#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Vigil - the receivers, collectors, alert engine and web UI, as the vigil user
# (the syslog port inside the container is 5514, so no root is needed)
# ==============================================================================

bashio::log.info "Starting Vigil.."
# Home Assistant's time zone (syslog lines without a zone are in local time); UTC when the
# Supervisor can't be asked. Not bashio::info: a failed API call would stop the script.
TZ="$(curl -s -m 5 -H "Authorization: Bearer ${SUPERVISOR_TOKEN:-}" http://supervisor/info 2>/dev/null \
    | jq -r '.data.timezone // empty' 2>/dev/null || true)"
export TZ="${TZ:-UTC}"
VIGIL_LOG_LEVEL="$(jq -r '.log_level // "info"' /data/options.json 2>/dev/null || echo info)"
export VIGIL_LOG_LEVEL
mkdir -p /data/vigil && chown vigil:vigil /data/vigil && chmod 700 /data/vigil
# options.json belongs to root; the app runs as vigil, so it gets a private copy (it holds the
# database and FRITZ!Box passwords). Home Assistant restarts the app when the options change.
install -o vigil -g vigil -m 600 /data/options.json /data/vigil/options.json
export VIGIL_OPTIONS=/data/vigil/options.json
cd /app || exit 1
# Its own home, not /root: the PostgreSQL client looks in ~/.postgresql/ for certificates when
# it connects, and a /root it may not open fails the connection with "Permission denied"
export HOME=/home/vigil
exec s6-setuidgid vigil python3 -m src
