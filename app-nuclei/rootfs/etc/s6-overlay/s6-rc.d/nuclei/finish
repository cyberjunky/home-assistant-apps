#!/command/with-contenv bashio
# Arguments: ${1} = exit code (256 when killed by a signal)
if [[ "${1:-0}" -ne 0 ]] && [[ "${1:-0}" -ne 256 ]]; then
    echo "[ERROR] Nuclei Scanner failed with exit code ${1}, stopping app"
    echo "${1:-0}" > /run/s6-linux-init-container-results/exitcode
    exec /run/s6/basedir/bin/halt
fi
echo "[INFO] Nuclei Scanner stopped"
