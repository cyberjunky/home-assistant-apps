#!/command/with-contenv bashio
# shellcheck shell=bash
# shellcheck source=/dev/null
source /usr/share/chronicle/common.sh
# ==============================================================================
# Chronicle - the web UI, as the chronicle user (it reaches the database as the
# chronicle_ui role over the local socket, without a password)
# ==============================================================================

bashio::log.info "Starting the Chronicle web UI.."
CHRONICLE_LOG_LEVEL="$(option log_level info)"
export CHRONICLE_LOG_LEVEL
cd /app || exit 1
exec s6-setuidgid chronicle python3 -m src
