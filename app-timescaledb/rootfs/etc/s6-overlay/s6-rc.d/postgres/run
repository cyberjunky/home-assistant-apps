#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start PostgreSQL service if enabled
# ==============================================================================
declare POSTGRES_DATA
declare UPDATE
declare POSTGRES_PID
declare VERSION_FILE
declare BUILD_TIMESTAMP

POSTGRES_DATA=/data/postgres
VERSION_FILE=/data/version
BUILD_TIMESTAMP="$(cat /build-timestamp)"
UPDATE=false

# Returns success when extension $2 is installed in database $1.
# Compares the query result instead of piping to 'grep -q': under bashio's errexit and
# pipefail, grep closing the pipe early can make an installed extension look missing
# (https://github.com/expaso/hassos-addon-timescaledb/pull/88).
extensionInstalled () {
	[[ "$(psql -X -U postgres -d "${1}" -tAc "select 1 from pg_extension where extname = '${2}';")" == "1" ]]
}

# Check if we need to update
if [[ $(< "${VERSION_FILE}") != "${BUILD_TIMESTAMP}" ]]; then
	UPDATE=true
fi

# Start Postgres
bashio::log.info "Starting PostgreSQL.."
su - postgres -c "postgres -D ${POSTGRES_DATA}" &
POSTGRES_PID=$!
bashio::log.info "done"

# Wait for postgres to become available..
while ! psql -U "postgres" postgres -c "" 2> /dev/null; do
	sleep 1
done

# Setup postgres user on first run
if [[ -f "/data/firstrun" ]]; then
	bashio::log.info "Setting up postgres user.."
	if bashio::config.has_value 'postgres_password'; then
		POSTGRES_PASSWORD=$(bashio::config 'postgres_password')
	else
		POSTGRES_PASSWORD="homeassistant"
		bashio::log.warning "No 'postgres_password' configured, using the default password 'homeassistant'. Please change it!"
	fi
	# Escape single quotes for the SQL literal
	psql -U "postgres" postgres -c "ALTER USER postgres WITH PASSWORD '${POSTGRES_PASSWORD//\'/\'\'}';"
fi

# Check for extension updates..
if bashio::var.true "${UPDATE}"; then

	bashio::log.notice "Addon was updated to version timestamp: ${BUILD_TIMESTAMP}. Performing database upgrades..."

	# Fetch all databases..
	psql \
		-X \
		-U postgres \
		-c "select datname from pg_database where datallowconn = true;" \
		--set ON_ERROR_STOP=on \
		--no-align \
		-t \
		--field-separator ' ' \
		--quiet \
	| while read -r datname; do
		# Update Timescale extension when needed
		extensionInstalled "${datname}" timescaledb \
		&& bashio::log.info "Try updating Timescale Extension for database: '${datname}'.." \
		&& psql -X -U postgres -d "${datname}" -c "ALTER EXTENSION timescaledb UPDATE;" || true >> /var/log/timescaledb.upgrade.log

		# Update Postgis when extension needed
		extensionInstalled "${datname}" postgis \
		&& bashio::log.info "Try updating Postgis Extension for database: '${datname}'.." \
		&& psql -X -U postgres -d "${datname}" -c "SELECT PostGIS_Extensions_Upgrade();" || true >> /var/log/postgis.upgrade.log

		# Update TimescaleDb Toolkit extension when needed
		extensionInstalled "${datname}" timescaledb_toolkit \
		&& bashio::log.info "Try updating TimescaleDb Toolkit Extension for database: '${datname}'.." \
		&& psql -X -U postgres -d "${datname}" -c "ALTER EXTENSION timescaledb_toolkit UPDATE;" || true >> /var/log/timescaledb_toolkit.upgrade.log

		# Update Vector extension when needed
		extensionInstalled "${datname}" vector \
		&& bashio::log.info "Try updating Vector Extension for database: '${datname}'.." \
		&& psql -X -U postgres -d "${datname}" -c "ALTER EXTENSION vector UPDATE;" || true >> /var/log/vector.upgrade.log

		# Update pg_cron extension when needed
		extensionInstalled "${datname}" pg_cron \
		&& bashio::log.info "Try updating pg_cron Extension for database: '${datname}'.." \
		&& psql -X -U postgres -d "${datname}" -c "ALTER EXTENSION pg_cron UPDATE;" || true >> /var/log/pg_cron.upgrade.log

	done
fi

# Enable the pg_cron job scheduler in the 'postgres' database (see cron.database_name)
if ! extensionInstalled postgres pg_cron; then
	bashio::log.info "Enabling pg_cron Extension.."
	psql -U "postgres" -d postgres -c "CREATE EXTENSION IF NOT EXISTS pg_cron;" || true >> /var/log/pg_cron.create.log
fi


if bashio::config.has_value 'databases'; then
	# Create all databases if not exist
	for database in $(bashio::config "databases"); do
		bashio::log.info "Create database if not exist: '${database}'"
		# Compare the query result instead of piping to 'grep -q', and only warn when the
		# database cannot be created: a failure here would stop PostgreSQL and the app.
		if [[ "$(psql -X -U postgres -tAc "SELECT 1 FROM pg_database WHERE datname = '${database}'")" != "1" ]]; then
			psql -X -U postgres -c "CREATE DATABASE ${database}" \
				|| bashio::log.warning "Could not create database '${database}', continuing.."
		fi
	done
	bashio::log.info "done"

	# Enable the timescale-extensions for all indicated databases
	for database in $(bashio::config "timescale_enabled"); do
		if ! extensionInstalled "${database}" timescaledb; then
			bashio::log.info "Enabling Timescale Extension for database: '${database}'"
			psql -U "postgres" -d "${database}" -c "CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE;" || true >> /var/log/timescaledb.create.log
		fi;
	done
fi
bashio::log.info "done"

# Exit update mode
rm -f /data/firstrun
if bashio::var.true "${UPDATE}"; then
	bashio::log.info "Exiting update mode and restarting.."
	# Write new addon-version
	echo "${BUILD_TIMESTAMP}" > "${VERSION_FILE}"
	sleep 3

	# Don't fail on the call. When running in standalone, this will fail.
	bashio::app.restart || true
fi

# And let it roll
bashio::log.notice "TimescaleDb is running!"
wait "${POSTGRES_PID}"
