ARG GO_VERSION=1.27.4

###########################################
# Build TimeScaleDB-tools
###########################################
FROM golang:${GO_VERSION}-alpine AS timescaledb-tools

# <timescaledb-tune>-<timescaledb-parallel-copy>-<timescaledb-backup>, as TIMESCALEDB_TOOLS_VERSION
# in the app's Dockerfile
ARG VERSION
ARG TARGETARCH
ARG TARGETVARIANT

# hadolint ignore=DL3018
RUN --mount=type=cache,id=apk-${TARGETARCH}-${TARGETVARIANT},sharing=locked,target=/var/cache/apk \
    apk update && apk add --no-cache \
        git \
        gcc \
        musl-dev \
    && tune="${VERSION%%-*}" && rest="${VERSION#*-}" && copy="${rest%%-*}" && backup="${rest#*-}" \
    && go install "github.com/timescale/timescaledb-tune/cmd/timescaledb-tune@v${tune}" \
    && go install "github.com/timescale/timescaledb-parallel-copy/cmd/timescaledb-parallel-copy@v${copy}" \
    && go install "github.com/timescale/timescaledb-backup/cmd/ts-dump@${backup}" \
    && go install "github.com/timescale/timescaledb-backup/cmd/ts-restore@${backup}"

# Labels
LABEL \
    org.opencontainers.image.source="https://github.com/cyberjunky/home-assistant-apps"
