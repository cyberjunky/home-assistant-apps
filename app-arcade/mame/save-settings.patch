+// The browser never reaches the exit phase of run() (the main loop is handed to the
+// browser and never returns), so NVRAM and settings would never be written: let the
+// page ask for it, as the exit phase does
+void running_machine::emscripten_save_settings() {
+	running_machine *machine = emscripten_running_machine;
+	if (!machine)
+		return;
+	if (machine->options().nvram_save())
+		machine->nvram_save();
+	machine->m_configuration->save_settings();
+}
 
