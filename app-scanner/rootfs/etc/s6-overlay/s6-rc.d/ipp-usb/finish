#!/command/with-contenv bash
# shellcheck shell=bash
# ==============================================================================
# ipp-usb stopped. Scanners with a SANE driver work without it, so the app keeps running.
# ==============================================================================
if [[ "${1:-0}" -ne 0 ]] && [[ "${1:-0}" -ne 256 ]]; then
    echo "[WARNING] ipp-usb (driverless USB scanners) stopped with code ${1}; trying again in 30 seconds"
    sleep 30
fi
