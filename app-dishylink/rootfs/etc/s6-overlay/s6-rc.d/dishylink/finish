#!/usr/bin/env bashio
# ==============================================================================
# Take down the S6 supervision tree when the Dishylink browser host fails
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

declare APP_EXIT_CODE=${1}

# Node has written its final snapshots on SIGTERM by now; put them on disk
# before the container goes away. No-op when the recorder writes to /data.
historian-flush || true

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.warning "Halt app with exit code ${APP_EXIT_CODE}"
  echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "Service restart after closing"
